# ReMatter AI Backend Configuration
HOST=0.0.0.0
PORT=8000

# Path or identifier for Ultralytics YOLO model.
# Defaults to 'yolov8n.pt' which is auto-downloaded on first run.
# For custom waste-trained weights, place your .pt file (e.g. weights/waste_model.pt)
# and update this variable accordingly:
MODEL_PATH=yolov8n.pt

# Default detection confidence threshold (0.05 - 0.95)
DEFAULT_CONFIDENCE=0.35

# Computation device: 'cpu' or 'cuda'
DEVICE=cpu

# Neural Vision Engine (Google Gemini Vision)
GEMINI_API_KEY=your_gemini_api_key_here
VISION_ENGINE=auto
